---
import type { Project } from '../data/portfolio';
import LiveLink from './LiveLink.astro';
interface Props { project: Project; index: number }
const { project, index } = Astro.props;
const href = `/work/${project.slug}`;
---
<article class:list={['project', project.featured && 'project--featured']} data-category={project.category}>
 <a class="project-visual" href={href} aria-label={`View the ${project.title} case study`}>
  <img
   src={project.previewImage}
   alt={project.previewAlt}
   width="2160"
   height="1350"
   loading={index === 0 ? 'eager' : 'lazy'}
   decoding="async"
   style={`object-position:${project.previewPosition}`}
  />
 </a>
 <div class="project-details">
  <div class="project-meta"><span>{String(index+1).padStart(2,'0')}</span>{project.conceptProject && <span class="concept-label">Independent concept</span>}</div>
  <div class="project-copy">
   <p class="project-type">{project.type} / {project.year}</p>
   <h3><a href={href}>{project.title}</a></h3>
   <p>{project.description}</p>
  </div>
  <ul aria-label="Capabilities demonstrated">{project.capabilities.map(item=><li>{item}</li>)}</ul>
  <div class="project-actions">
   <a class="project-action" href={href}>View case study <span aria-hidden="true">→</span></a>
   <LiveLink project={project} />
  </div>
 </div>
</article>
