---
import { site } from '../data/portfolio';
---

<header class="site-header">
  <a class="brand" href="#top" aria-label={`${site.name}, home`}>{site.name}</a>
  <a
    class="btn btn--primary header-contact"
    href="#project-dialog"
    data-open-project
    aria-haspopup="dialog"
    aria-controls="project-dialog"
  >
    <span>Contact</span><i aria-hidden="true">↗</i>
  </a>
</header>
