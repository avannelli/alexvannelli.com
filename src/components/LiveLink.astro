---
import type { Project } from '../data/portfolio';
interface Props { project: Project; variant?: 'action' | 'quiet' }
const { project, variant = 'action' } = Astro.props;
---
{/* Renders nothing when liveUrl is empty, so a project without a deployment never shows a broken link. */}
{project.liveUrl && (
 <a
  class:list={['project-action', variant === 'action' && 'project-action--live']}
  href={project.liveUrl}
  target="_blank"
  rel="noopener noreferrer"
 >
  {project.liveLabel} <span aria-hidden="true">↗</span><span class="visually-hidden">(opens in a new tab)</span>
 </a>
)}
