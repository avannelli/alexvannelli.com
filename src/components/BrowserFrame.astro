---
// A screenshot in minimal browser chrome. The address bar shows the real
// domain so every frame reads as a live site, not a picture of one.
import { Image } from 'astro:assets';
import type { Shot } from '../data/portfolio';

interface Props {
  shot: Shot;
  domain: string;
  /** Layout width hint for responsive image selection. */
  sizes: string;
  eager?: boolean;
  class?: string;
  style?: string;
  [key: `data-${string}`]: string | boolean | undefined;
}

const { shot, domain, sizes, eager = false, class: className, ...attrs } = Astro.props;
---

<figure class:list={['browser', className]} {...attrs}>
  <div class="browser-bar" aria-hidden="true">
    <span class="browser-dots"><i></i><i></i><i></i></span>
    <span class="browser-url">{domain}</span>
  </div>
  <Image
    src={shot.src}
    alt={shot.alt}
    widths={[640, 960, 1280, 1920, 2880]}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
  />
</figure>
