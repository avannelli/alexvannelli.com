---
import { site } from '../data/portfolio';
const fieldId = (name: string) => 'dialog-' + name;
---
<form class="inquiry-form" data-inquiry-form data-email={site.email}>
 <div class="field"><label for={fieldId('name')}>Name</label><input id={fieldId('name')} name="name" autocomplete="name" placeholder="Your name" required /></div>
 <div class="field"><label for={fieldId('business')}>Business <span>Optional</span></label><input id={fieldId('business')} name="business" autocomplete="organization" placeholder="Business name" /></div>
 <div class="field"><label for={fieldId('email')}>Email</label><input id={fieldId('email')} name="email" type="email" autocomplete="email" placeholder="you@business.com" required /></div>
 <div class="field"><label for={fieldId('website')}>Existing website <span>Optional</span></label><input id={fieldId('website')} name="website" type="url" placeholder="https://" /></div>
 <div class="field field--wide"><label for={fieldId('project-type')}>Type of project</label><select id={fieldId('project-type')} name="project-type" required><option value="">Select a project type</option><option>New website</option><option>Website redesign</option><option>Online shop</option><option>Interactive experience</option><option>Not sure yet</option></select></div>
 <div class="field field--wide"><label for={fieldId('description')}>What should the website do?</label><textarea id={fieldId('description')} name="description" rows="4" placeholder="Tell me about the business and what you have in mind." required></textarea></div>
 <div class="form-end">
  <p data-form-status aria-live="polite">Sending opens your email app with these details filled in — nothing is stored on this site.</p>
  <button class="btn btn--primary" type="submit">Write the email <i aria-hidden="true">↗</i></button>
 </div>
</form>
<script>
 /* No backend: the form composes a pre-filled email for the visitor to send
    from their own mail app. The status line says exactly that, so it never
    claims the inquiry has been delivered. */
 document.querySelectorAll<HTMLFormElement>('[data-inquiry-form]').forEach(form=>form.addEventListener('submit',event=>{
  event.preventDefault();
  if(!form.reportValidity())return;
  const data=new FormData(form);
  const value=(key:string)=>String(data.get(key)??'').trim();
  const subject=`Project inquiry — ${value('business')||value('name')}`;
  const body=[
   `Name: ${value('name')}`,
   value('business')&&`Business: ${value('business')}`,
   `Email: ${value('email')}`,
   value('website')&&`Existing website: ${value('website')}`,
   `Type of project: ${value('project-type')}`,
   '',
   value('description'),
  ].filter(line=>line!=='').join('\n');
  location.href=`mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  const status=form.querySelector<HTMLElement>('[data-form-status]');
  if(status)status.textContent=`Your email app should now open with the inquiry ready to send. If it didn’t, write to ${form.dataset.email} directly.`;
 }));
</script>
