---
import { site } from '../data/portfolio';
import '../styles/global.css';
import '../styles/theme.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#050506" />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" href="/fonts/sora-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{site.title}</title>
    <!-- Set before paint so reveal targets start hidden only when the motion
         script can actually reveal them. Without JS they stay visible. -->
    <script is:inline>document.documentElement.classList.add('js')</script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>import '../scripts/motion.ts';</script>
  </body>
</html>



