---
import { site } from '../data/portfolio';
import '../styles/theme.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectDialog from '../components/ProjectDialog.astro';

interface Props {
  title?: string;
  description?: string;
  /** The header's starting world; see Header.astro. */
  headerWorld?: string;
  headerRail?: boolean;
}

const { title = site.title, description = site.description, headerWorld, headerRail } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f2ede3" />
    <meta name="color-scheme" content="light" />
    <link rel="preload" href="/fonts/instrument-serif-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Set before paint so animated elements start hidden only when the
         motion script can actually reveal them. Without JS they stay visible. -->
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header world={headerWorld} rail={headerRail} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ProjectDialog />
    <script>import '../scripts/motion.ts';</script>
  </body>
</html>
