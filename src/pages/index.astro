---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroArtwork from '../components/HeroArtwork.astro';

import ProjectDialog from '../components/ProjectDialog.astro';
import ProjectIdentity from '../components/ProjectIdentity.astro';
import Footer from '../components/Footer.astro';
import { projects, process } from '../data/portfolio';
import '../styles/home.css';
---
<Layout>
 <div class="home-page" id="top">
  <Header />
  <main id="main">
   <section class="opening wrap" aria-labelledby="home-title">
    <HeroArtwork />
    <div class="opening-meta"><span>Independent by design</span><span>Design / Development / Exploration</span></div>
    <div class="opening-name"><h1 id="home-title"><span class="name-first">Alessandro</span><span class="name-last" data-text="Vannelli">Vannelli</span></h1><p><span class="label-code" aria-hidden="true"><b>MODEL 01</b>/ SERIES A</span><span class="label-rule" aria-hidden="true"></span><span class="label-text">Independent Web Design &amp; Development</span><span class="label-rule" aria-hidden="true"></span><span class="label-code" aria-hidden="true">EST. <b>2026</b></span></p></div>
    <div class="opening-projects">
     <p class="eyebrow">Three projects. Three different worlds.</p>
     <div class="identity-row">{projects.map((project,index)=><a href={`#${project.slug}`} style={`--delay:${.85+index*.18}s`}><span class="ch-top" aria-hidden="true"><span class="ch-num">0{index+1}</span><span class="ch-cat">{project.category.split(/\s|&/)[0]}</span><span class="ch-state"><span class="ch-led"></span></span></span><ProjectIdentity project={project} /><span class="identity-arrow" aria-hidden="true">▶</span><span class="ch-cursor" aria-hidden="true">▶</span><span class="ch-bar" aria-hidden="true"></span></a>)}</div>
    </div>
    <div class="opening-bottom"><p>Websites with a point of view.<br /><span>Designed and built by one pair of hands.</span></p><span class="press-start" aria-hidden="true">CATALOGUE VOL. 01 — P. 01</span></div>
   </section>
   <section id="work" class="showcase wrap" aria-labelledby="work-title">
    <div class="section-rail"><h2 id="work-title">Showcase</h2><span>Personal projects &amp; independent concepts</span><span>01 — 03</span></div>
    {projects.map((project,index)=><article id={project.slug} class:list={['work-piece',`work-${project.slug}`,index%2===1 && 'work-piece-reverse']}>
     <div class="work-heading"><span class="work-number">0{index+1}</span><h3><a href={`/work/${project.slug}`}>{project.title}</a></h3><span class="work-kind">{project.conceptProject ? 'Independent concept' : 'Personal project'}</span></div>
     <div class="work-composition">
      <a class="work-stage" href={project.liveUrl} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${project.title} (opens in a new tab)`}>
       <span class="stage-grid" aria-hidden="true"></span><span class="stage-label">{project.category}</span>
       <div class="site-window"><div class="window-bar"><span aria-hidden="true">● ● ●</span><span>{new URL(project.liveUrl).hostname}</span><span aria-hidden="true">↗</span></div><img src={project.previewImage} alt={project.previewAlt} width="1440" height="900" loading="lazy" decoding="async" style={`object-position:${project.previewPosition}`} /></div>
       <span class="stage-caption">Designed &amp; developed by Alessandro Vannelli<span>Open website ↗</span></span>
      </a>
      <div class="work-note"><ProjectIdentity project={project} /><p class="work-summary">{index===0 ? 'A little nostalgia. A lot of play.' : index===1 ? 'Structure, with a different perspective.' : 'A warmer welcome to the everyday.'}</p><p class="work-description">{index===0 ? 'An original browser arcade. Five games, one shared cabinet, and a visual world built from scratch.' : index===1 ? 'An engineering consultancy concept that brings technical work to life through bold type and structural illustration.' : 'A bakery concept with an illustrated identity, a considered menu, and its own unhurried rhythm.'}</p><ul class="work-tags">{project.capabilities.slice(0,3).map(tag=><li>{tag}</li>)}</ul><a class="case-link" href={`/work/${project.slug}`}>Inside the project <span aria-hidden="true">↗</span></a></div>
     </div>
    </article>)}
   </section>
   <section class="approach wrap" id="process" aria-labelledby="process-title">
    <div class="section-rail"><h2 id="process-title">The approach</h2><span>One person. From first sketch to final build.</span></div>
    <div class="approach-layout"><div class="approach-intro"><p class="large-statement">Good websites<br />start with<br /><em>your world.</em></p><p>I’m Alessandro. I design and build websites for local and independent businesses. We work directly together, shaping the details around what makes your business yours.</p><button type="button" data-open-project class="action-link">Tell me what you have in mind <span aria-hidden="true">↗</span></button></div><div class="process-list">{process.map((stage,index)=><details name="process" open={index===0}><summary>{stage.name}<span aria-hidden="true">+</span></summary><p>{stage.text}</p></details>)}<p class="process-footnote">A clear direction. Room to experiment.<br />Care in the details, on every screen.</p></div></div>
   </section>
  </main>
  <Footer /><ProjectDialog />
 </div>
 <script>
  const motion=window.matchMedia('(prefers-reduced-motion: reduce)');
  if('IntersectionObserver' in window){const observer=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting){if(!motion.matches)entry.target.animate([{opacity:.4,transform:'translateY(24px)'},{opacity:1,transform:'none'}],{duration:700,easing:'cubic-bezier(.2,.7,.3,1)'});observer.unobserve(entry.target)}})},{threshold:.12});document.querySelectorAll('.work-composition,.approach-layout').forEach(el=>observer.observe(el));}
  motion.addEventListener('change',()=>{if(motion.matches)document.getAnimations().forEach(a=>a.finish())});
  const menuButton=document.querySelector<HTMLButtonElement>('.menu-button');const menu=document.querySelector<HTMLElement>('#main-nav');
  document.addEventListener('keydown',event=>{if(menuButton?.getAttribute('aria-expanded')!=='true')return;if(event.key==='Escape')menuButton.focus();if(event.key!=='Tab')return;const controls=[menuButton,...menu!.querySelectorAll<HTMLAnchorElement>('a')];if(event.shiftKey&&document.activeElement===controls[0]){event.preventDefault();controls.at(-1)?.focus()}else if(!event.shiftKey&&document.activeElement===controls.at(-1)){event.preventDefault();menuButton.focus()}});
  window.matchMedia('(min-width: 641px)').addEventListener('change',event=>{if(event.matches&&menuButton?.getAttribute('aria-expanded')==='true')menuButton.click()});
 </script>
</Layout>



