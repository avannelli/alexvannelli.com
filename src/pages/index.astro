---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import InquiryForm from '../components/InquiryForm.astro';
import ProjectDialog from '../components/ProjectDialog.astro';
import Footer from '../components/Footer.astro';
import { projects, categories, capabilities, process, site } from '../data/portfolio';
---
<Layout>
 <div id="top"></div><Header />
 <main id="main">
  <section class="intro wrap" aria-labelledby="intro-title"><h1 id="intro-title">Websites built<br />for <em>business.</em></h1><div class="intro-bottom"><div class="intro-copy"><p>Distinctive, fast websites for businesses ready to move beyond generic templates.</p><aside class="profile-card"><div class="profile-photo" role="img" aria-label="Portrait placeholder for Alessandro Vannelli"><span>Portrait<br />coming soon</span></div><div class="profile-copy"><span>Designer &amp; developer</span><h2>Alessandro Vannelli</h2><p>React experience, modern tools, and careful design judgment—focused on building dependable websites.</p></div></aside></div><div class="intro-actions"><a class="button button--light" href="#work"><span>View showcase</span><i aria-hidden="true">↓</i></a><button class="button button--accent" type="button" data-open-project><span>Start a project</span><i aria-hidden="true">↗</i></button></div></div></section>
  <section id="work" class="work-section"><div class="filter-wrap wrap" aria-label="Filter projects"><p class="filter-label">Showcase</p><button class="filter-scroll" data-direction="left" aria-label="Scroll filters left">←</button><div class="filters">{categories.map((category,index)=><button type="button" class:list={[index===0&&'is-active']} data-filter={category} aria-pressed={index===0?'true':'false'}>{category}</button>)}</div><button class="filter-scroll" data-direction="right" aria-label="Scroll filters right">→</button></div><div class="project-list wrap">{projects.map((project,index)=><ProjectCard project={project} index={index} />)}</div></section>
  <section id="process" class="process-section"><div class="wrap"><div class="process-title"><p class="section-title">How it works</p><h2>A clear process.</h2></div><div class="process-list">{process.map(stage=><article><span>{stage.number}</span><h3>{stage.name}</h3><p>{stage.text}</p></article>)}</div></div></section>
  <section id="capabilities" class="capabilities wrap"><div class="section-head"><p class="section-title">What I can build</p><h2>From idea to launch.</h2></div><div class="capability-table">{capabilities.map((item,index)=><article class="capability-row"><span>{String(index+1).padStart(2,'0')}</span><h3>{item.title}</h3><p>{item.summary}</p><small>{item.detail}</small></article>)}</div></section>
  <section id="contact" class="contact-section"><div class="wrap contact-grid"><div><p class="section-title">Have something in mind?</p><h2>Tell me what<br />you’re building.</h2><p class="contact-lead">A new site, a thoughtful redesign, or an idea ready to take shape.</p><div class="availability"><i></i><span>Available for select projects</span></div></div><InquiryForm idPrefix="page" /></div></section>
 </main>
 <Footer />
 <ProjectDialog />
 <script>
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-category]');
  let filtering = false;
  filters.forEach((button) => button.addEventListener('click', async () => {
    if (filtering || button.classList.contains('is-active')) return;
    filtering = true;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const currentCards = [...cards].filter((card) => !card.hidden);
    if (!reducedMotion) {
      await Promise.all(currentCards.map((card) => card.animate(
        [{ opacity: 1, transform: 'translateY(0)' }, { opacity: 0, transform: 'translateY(8px)' }],
        { duration: 150, easing: 'ease-in', fill: 'forwards' }
      ).finished.catch(() => undefined)));
    }
    filters.forEach((item) => { item.classList.remove('is-active'); item.setAttribute('aria-pressed', 'false'); });
    button.classList.add('is-active');
    button.setAttribute('aria-pressed', 'true');
    const value = button.dataset.filter;
    cards.forEach((card) => { card.hidden = value !== 'All projects' && card.dataset.category !== value; });
    const nextCards = [...cards].filter((card) => !card.hidden);
    if (!reducedMotion) {
      nextCards.forEach((card, index) => card.animate(
        [{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'translateY(0)' }],
        { duration: 240, delay: index * 35, easing: 'cubic-bezier(.22,.7,.26,1)', fill: 'both' }
      ));
    }
    filtering = false;
  }));
  document.querySelectorAll<HTMLButtonElement>('.filter-scroll').forEach((button) => button.addEventListener('click', () => document.querySelector('.filters')?.scrollBy({ left: button.dataset.direction === 'left' ? -260 : 260, behavior: 'smooth' })));
 </script>
</Layout>










